{
  "manifest_version": 3,
  "name": "AI Canvas Studio - Muse AI & Flow Automation Bridge",
  "version": "5.3.0",
  "description": "Cầu nối tự động hóa Multi-Tab giữa AI Canvas Studio và Muse AI (muse.ai) & Google Flow (Auto-Piping Base64, Multi-Tab Pool, Image/Video Mode Switch).",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage",
    "debugger",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allow_localhost_iframe",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "<all_urls>",
    "https://muse.ai/*",
    "https://*.muse.ai/*",
    "https://*.meta.ai/*",
    "https://labs.google/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://muse.ai/*",
        "https://*.muse.ai/*",
        "https://labs.google/*",
        "https://flow.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["canvas-bridge.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
