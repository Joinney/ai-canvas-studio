{
  "manifest_version": 3,
  "name": "AI Canvas Studio - Google Flow Automation Bridge",
  "version": "4.2.1",
  "description": "Cầu nối tự động hóa Multi-Tab giữa AI Canvas Studio và Google Flow (Auto-Piping Base64, Multi-Tab Pool, Image/Video Mode Switch).",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://labs.google/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*",
        "https://flow.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["canvas-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
